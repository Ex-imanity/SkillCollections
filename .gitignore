# --- IDE / local agent ---
.idea/
.claude/
.omc/
**/.omc/
.DS_Store
**/.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# --- Logs & process handles ---
*.log
*.log.*
*.pid
*.stderr
*.stdout

# --- Cross-agent-review / gate runtime ---
